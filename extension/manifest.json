{
  "manifest_version": 3,
  "name": "Clip-Direct",
  "version": "1.3.23",
  "description": "Mark clip times on video pages and send them to Clip-Direct for download to your PC.",
  "permissions": ["storage", "activeTab", "scripting", "webRequest", "tabs", "cookies", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Clip-Direct"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "mark-start": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Mark clip start at the current video time"
    },
    "mark-end": {
      "suggested_key": { "default": "Alt+Shift+E" },
      "description": "Mark clip end at the current video time"
    },
    "show-bar": {
      "description": "Show the Clip-Direct bar on the page"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["lib/locales/en.json", "lib/locales/de.json", "lib/keep-playback.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": [
        "*://*.youtube.com/*",
        "*://youtube.com/*",
        "*://youtu.be/*",
        "*://*.youtu.be/*",
        "*://*.youtube-nocookie.com/*",
        "*://*.vimeo.com/*",
        "*://vimeo.com/*",
        "*://*.netflix.com/*",
        "*://*.twitch.tv/*",
        "*://localhost/*",
        "*://127.0.0.1/*"
      ],
      "js": ["lib/keep-playback-boot.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["lib/content-i18n.js", "lib/stream-url-match.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
